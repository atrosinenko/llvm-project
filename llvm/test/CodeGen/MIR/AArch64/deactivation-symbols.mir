# RUN: llc < %s -O0 -mtriple=aarch64-none-linux-gnu -mattr=+pauth -run-pass irtranslator -x mir | \
# RUN:   llc -x mir -run-pass legalizer | FileCheck %s

--- |
  @ds = external global i8

  define ptr @pauth_sign_zero(ptr %p) {
    ; CHECK: G_PTRAUTH_SIGN %0, %2(s0), deactivation-symbol @ds
    %signed = call ptr @llvm.ptrauth.sign.p0(ptr %p) [ "ptrauth"(i64 0, i64 0, i64 0), "deactivation-symbol"(ptr @ds) ]
    ret ptr %signed
  }
...
