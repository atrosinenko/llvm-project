# RUN: llc < %s -O0 -mtriple=aarch64-none-linux-gnu -mattr=+pauth -run-pass irtranslator -x mir | \
# RUN:   llc -x mir -run-pass legalizer | FileCheck %s

--- |
  @ds1 = external global i8

  define ptr @pauth_sign_zero(ptr %p) {
    ; CHECK: G_PTRAUTH_SIGN %0, %2(s0), deactivation-symbol @ds1
    %signed = call ptr @llvm.ptrauth.sign.p0(ptr %p) [ "ptrauth"(i64 0, i64 0, i64 0), "deactivation-symbol"(ptr @ds1) ]
    ret ptr %signed
  }

  @ds2 = external global i8

  define ptr @pauth_sign_zero_swapped_bundles(ptr %p) {
    ; CHECK: G_PTRAUTH_SIGN %0, %2(s0), deactivation-symbol @ds2
    %signed = call ptr @llvm.ptrauth.sign.p0(ptr %p) [ "deactivation-symbol"(ptr @ds2), "ptrauth"(i64 0, i64 0, i64 0) ]
    ret ptr %signed
  }
...
