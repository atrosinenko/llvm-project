; bb.blend.1:
;   ...
; bb.blend.2:
;   ...
; bb.phi:
;   %addr = phi i64 [ %addr.1, %bb.blend.1 ], [ %addr.2, %bb.blend.2 ], ...
;   %disc = call i64 @llvm.ptrauth.blend(i64 %addr, i64 COMMON_IMM)
; bb.user:
;   %result = call @llvm.ptrauth.sign(i64 %ptr, i32 0, i64 %disc)

