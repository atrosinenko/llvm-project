;
; bb.blend.1:
;   %disc.1 = call i64 @llvm.ptrauth.blend(i64 %addr.1, i64 COMMON_IMM)
; bb.blend.2:
;   %disc.2 = call i64 @llvm.ptrauth.blend(i64 %addr.2, i64 COMMON_IMM)
; ...
; bb.phi:
;   %disc = phi i64 [ %disc.1, %bb.blend.1 ], [ %disc.2, %bb.blend.2 ], ...
; bb.user:
